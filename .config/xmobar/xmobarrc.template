-- This is the source of truth for xmobarrc. The @@TOKEN@@ placeholders
-- below are substituted by ~/.config/xmonad/scripts/theme-chooser.sh on
-- every theme switch, which writes the result to xmobarrc and respawns
-- xmobar (via ~/.config/xmobar/restart.sh). Edit THIS file, never
-- xmobarrc directly -- xmobarrc is regenerated and overwritten on the
-- next theme switch.
Config { font             = "JetBrainsMono Nerd Font Mono 10"
       , additionalFonts  = ["JetBrainsMono Nerd Font Propo 13"]
       , bgColor          = "@@BG@@"
       , fgColor          = "@@FG@@"
       , position         = Static { xpos = 0, ypos = 0, width = 1920, height = 24 }
       , border           = NoBorder
       , alpha            = 245
       , allDesktops      = True
       , overrideRedirect = True
       , commands = [ Run UnsafeXPropertyLog "_XMONAD_LOG"
                    , Run Date "%a %d %b  %H:%M:%S" "date" 10
                    , Run Com "/home/lucas/.local/bin/getweather" [] "weather" 6000
                    , Run Cpu
                        [ "-t", "<fn=1></fn> <total>%"
                        , "-H", "85", "--high", "@@RED@@"
                        , "-L", "50", "--normal", "@@WARN@@"
                        ] 20
                    , Run Memory
                        [ "-t", "<fn=1></fn> <used>GiB / <total>GiB"
                        , "-H", "85", "--high", "@@RED@@"
                        , "-L", "50", "--normal", "@@WARN@@"
                        , "-d", "1"
                        , "--", "--scale", "1024"
                        ] 20
                    , Run Volume "default" "Master"
                        [ "-t", "<status> <volume>%"
                        , "--", "-O", "<fn=1></fn> ", "-o", "<fn=1></fn> ", "-c", "@@MUTED@@", "-C", "@@MUTED@@"
                        ] 10
                    ]
       , sepChar  = "%"
       , alignSep = "}{"
       , template = "<hspace=8/><fc=@@PRIMARY@@><action=`$HOME/.config/xmonad/scripts/theme-chooser.sh` button=1></action></fc><hspace=12/><fc=@@WARN@@><action=`eww open --toggle sidemenu --screen $XMOBAR_SCREEN` button=1>  </action></fc>%_XMONAD_LOG% } <fc=@@GREEN@@><action=`eww open --toggle calendar_full --screen $XMOBAR_SCREEN` button=1> %date%</action></fc> { <fc=@@CYAN@@><action=`eww open --toggle weather --screen $XMOBAR_SCREEN` button=1><box type=Bottom width=3 mb=1 color=@@CYAN@@>%weather%</box></action></fc><icon=/home/lucas/.config/xmobar/icons/spacer20.xbm/><fc=@@MAGENTA@@><action=`eww open --toggle storagemon --screen $XMOBAR_SCREEN` button=1><box type=Bottom width=3 mb=1 color=@@MAGENTA@@>%cpu%</box></action></fc><icon=/home/lucas/.config/xmobar/icons/spacer20.xbm/><fc=@@PINK@@><action=`eww open --toggle storagemon --screen $XMOBAR_SCREEN` button=1><box type=Bottom width=3 mb=1 color=@@PINK@@>%memory%</box></action></fc><icon=/home/lucas/.config/xmobar/icons/spacer20.xbm/><fc=@@MUTED@@><action=`amixer -q sset Master toggle` button=1><box type=Bottom width=3 mb=1 color=@@MUTED@@>%default:Master%</box></action></fc><hspace=10/>"
       }
