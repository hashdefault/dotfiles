Config { font             = "JetBrainsMono Nerd Font Mono 10"
       , additionalFonts  = ["JetBrainsMono Nerd Font Propo 13"]
       , bgColor          = "#212337"
       , fgColor          = "#ebfafa"
       , position         = Static { xpos = 0, ypos = 0, width = 1920, height = 24 }
       , border           = NoBorder
       , alpha            = 245
       , allDesktops      = True
       , overrideRedirect = True
       , commands = [ Run UnsafeXPropertyLog "_XMONAD_LOG"
                    , Run Date "%a %d %b  %H:%M:%S" "date" 10
                    , Run Com "/home/lucas/.local/bin/getweather" [] "weather" 6000
                    , Run Cpu
                        [ "-t", "<fn=1></fn> <total>%"
                        , "-H", "85", "--high", "#f0313e"
                        , "-L", "50", "--normal", "#f1fc79"
                        ] 20
                    , Run Memory
                        [ "-t", "<fn=1></fn> <used>GiB / <total>GiB"
                        , "-H", "85", "--high", "#f0313e"
                        , "-L", "50", "--normal", "#f7c67f"
                        , "-d", "1"
                        , "--", "--scale", "1024"
                        ] 20
                    , Run Volume "default" "Master"
                        [ "-t", "<status> <volume>%"
                        , "--", "-O", "<fn=1></fn> ", "-o", "<fn=1></fn> ", "-c", "#ABB4DA", "-C", "#ABB4DA"
                        ] 10
                    ]
       , sepChar  = "%"
       , alignSep = "}{"
       , template = "<hspace=10/><fc=#f7c67f><action=`eww open --toggle sidemenu --screen $XMOBAR_SCREEN` button=1>  </action></fc>%_XMONAD_LOG% } <fc=#00ff99><action=`eww open --toggle calendar_full --screen $XMOBAR_SCREEN` button=1> %date%</action></fc> { <fc=#04d1f9><action=`eww open --toggle weather --screen $XMOBAR_SCREEN` button=1><box type=Bottom width=3 mb=1 color=#04d1f9>%weather%</box></action></fc><icon=/home/lucas/.config/xmobar/icons/spacer20.xbm/><fc=#a48cf2><action=`eww open --toggle storagemon --screen $XMOBAR_SCREEN` button=1><box type=Bottom width=3 mb=1 color=#a48cf2>%cpu%</box></action></fc><icon=/home/lucas/.config/xmobar/icons/spacer20.xbm/><fc=#f265b5><action=`eww open --toggle storagemon --screen $XMOBAR_SCREEN` button=1><box type=Bottom width=3 mb=1 color=#f265b5>%memory%</box></action></fc><icon=/home/lucas/.config/xmobar/icons/spacer20.xbm/><fc=#ABB4DA><action=`amixer -q sset Master toggle` button=1><box type=Bottom width=3 mb=1 color=#ABB4DA>%default:Master%</box></action></fc><hspace=10/>"
       }
