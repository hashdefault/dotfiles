-- This is the source of truth for xmobarrc. The @@TOKEN@@ placeholders
-- below are substituted by ~/.config/xmonad/scripts/theme-chooser.sh on
-- every theme switch, which writes the result to xmobarrc and respawns
-- xmobar (via ~/.config/xmobar/restart.sh). Edit THIS file, never
-- xmobarrc directly -- xmobarrc is regenerated and overwritten on the
-- next theme switch.
Config { font             = "JetBrainsMono Nerd Font Mono 10"
       , additionalFonts  = ["JetBrainsMono Nerd Font Propo 13"]
       , bgColor          = "#12142a"
       , fgColor          = "#ebfafa"
       , position         = Static { xpos = 0, ypos = 0, width = 1920, height = 24 }
       , border           = NoBorder
       , alpha            = 245
       , allDesktops      = True
       , overrideRedirect = True
       , commands = [ Run UnsafeXPropertyLog "_XMONAD_LOG"
                    , Run Date "%a %d %b  %H:%M:%S" "date" 10
                    , Run Com "/home/lucas/.local/bin/getweather" [] "weather" 6000
                    , Run Cpu
                        [ "-t", "<fn=1></fn> <total>%"
                        , "-H", "85", "--high", "#f16c75"
                        , "-L", "50", "--normal", "#f1fc79"
                        ] 20
                    , Run Memory
                        [ "-t", "<fn=1></fn> <used>GiB / <total>GiB"
                        , "-H", "85", "--high", "#f16c75"
                        , "-L", "50", "--normal", "#f1fc79"
                        , "-d", "1"
                        , "--", "--scale", "1024"
                        ] 20
                    , Run Volume "default" "Master"
                        [ "-t", "<status> <volume>%"
                        , "--", "-O", "<fn=1></fn> ", "-o", "<fn=1></fn> ", "-c", "#7081d0", "-C", "#7081d0"
                        ] 10
                    ]
       , sepChar  = "%"
       , alignSep = "}{"
       , template = "<hspace=8/><fc=#37f499><action=`$HOME/.config/xmonad/scripts/theme-chooser.sh` button=1></action></fc><hspace=12/><fc=#f1fc79><action=`eww open --toggle sidemenu --screen $XMOBAR_SCREEN` button=1>  </action></fc>%_XMONAD_LOG% } <fc=#37f499><action=`eww open --toggle calendar_full --screen $XMOBAR_SCREEN` button=1> %date%</action></fc> { <fc=#04d1f9><action=`eww open --toggle weather --screen $XMOBAR_SCREEN` button=1><box type=Bottom width=3 mb=1 color=#04d1f9>%weather%</box></action></fc><icon=/home/lucas/.config/xmobar/icons/spacer20.xbm/><fc=#a48cf2><action=`eww open --toggle storagemon --screen $XMOBAR_SCREEN` button=1><box type=Bottom width=3 mb=1 color=#a48cf2>%cpu%</box></action></fc><icon=/home/lucas/.config/xmobar/icons/spacer20.xbm/><fc=#f265b5><action=`eww open --toggle storagemon --screen $XMOBAR_SCREEN` button=1><box type=Bottom width=3 mb=1 color=#f265b5>%memory%</box></action></fc><icon=/home/lucas/.config/xmobar/icons/spacer20.xbm/><fc=#7081d0><action=`amixer -q sset Master toggle` button=1><box type=Bottom width=3 mb=1 color=#7081d0>%default:Master%</box></action></fc><hspace=10/>"
       }
