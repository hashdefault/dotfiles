# Color palette only. Keep behavior/window settings in this file.
#config-file = /home/lucas/.config/ghostty/theme.ghostty
#palette-generate = true

theme = Flexoki Dark
# Interface polish that keeps the imported theme colors untouched.
window-padding-x = 5
window-padding-y = 4
window-padding-balance = true

background-opacity = 1
background-blur = true

cursor-style = block
cursor-style-blink = true
mouse-hide-while-typing = true

shell-integration = fish
shell-integration-features = no-cursor

resize-overlay = always
resize-overlay-position = bottom-right
font-family = "Hack Mono NF"
font-size = 17
# Useful defaults for day-to-day terminal work.
clipboard-paste-protection = true
clipboard-trim-trailing-spaces = true
copy-on-select = true
window-decoration = server
