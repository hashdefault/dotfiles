(defwidget powermenu [] 
  (box :orientation "h" :space-evenly "true" :halign "center" :class "powermenu"
    (box :orientation "v" :halign "center" :class "power-item"
      (eventbox :class "hover-power-btn" :timeout "20ms" :cursor "pointer" 
        (button :class "power-button" :onclick "systemctl poweroff" "⏻"  )
      )
      (label :class "power-description" :text "Shutdown" :justify "center")
    )
    (box :orientation "v" :halign "center" :class "power-item"
      (eventbox :class "hover-power-btn" :timeout "20ms" :cursor "pointer" 
        (button :class "reboot-button" :onclick "systemctl reboot" "")
      )
      (label :class "reboot-description" :text "Reboot" :justify "center")
    )
    (box :orientation "v" :halign "center" :class "power-item"
      (eventbox :class "hover-power-btn" :timeout "20ms" :cursor "pointer" 
        (button :class "logout-button" :timeout "5000ms" :onclick "~/.config/eww/scripts/session_exit" "")
      )
      (label :class "logout-description" :text "Logout" :justify "center")
    )
    (box :orientation "v" :halign "center" :class "power-item"
      (eventbox :class "hover-power-btn" :timeout "20ms" :cursor "pointer" 
        (button :class "suspend-button" :onclick "systemctl suspend" "󰤄")
      )
      (label :class "suspend-description" :text "Suspend" :justify "center")
    )))

    (defwindow powermenu
			    :geometry (geometry  :x "0px"
                               :y "0px"
                               :width "400px"
                               :height "100px"
                               :anchor "center"
                               )
			     				(box :class "powermenu-window" (powermenu)))
