(defwidget calendar_full []
     (box :orientation "v" :space-evenly "false" :class "calendar_full"
        (box :orientation "h" :space-evenly "false" :halign "center" :class "calendar_header"
           (box :class "number_day" number_day)
           (box :orientation "v" :space-evenly "false" :valign "center" :class "calendar_header_text"
              (box :class "calendar_day" day)
              (box :class "calendar_date" "${month_full} ${year_full}")))
        (box :class "calendar_panel"
           (calendar :show-details "true" :class "calendar_grid"))))

;; Date vars
(defpoll number_day :interval "5h"  "date \"+%d\"")
(defpoll min :interval "10s"  "date \"+%M\"")
(defpoll hour :interval "10s"  "date \"+%H\"")
(defpoll day :interval "15h"  "~/.config/eww/scripts/getday")
(defpoll month_full :interval "15h"  "date \"+%B\"")
(defpoll year_full :interval "15h"  "date \"+%Y\"")

;; Main Stuff
(defwindow calendar_full
     :geometry (geometry :x "0px"
                         :y "24px"
                         :width "270px"
                         :height "360px"
                         :anchor "top center"
                         )
        (calendar_full))
