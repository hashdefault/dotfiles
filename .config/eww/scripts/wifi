#!/usr/bin/env bash

set -euo pipefail

cmd=${1:-}

is_on() {
  # nmcli general reports enabled/disabled on NetworkManager
  state=$(nmcli -g WIFI general status 2>/dev/null || echo "unknown")
  [[ "$state" == "enabled" ]] && return 0 || return 1
}

case "$cmd" in
  --toggle)
    if is_on; then
      nmcli radio wifi off
      exit $?
    else
      nmcli radio wifi on
      exit $?
    fi
    ;;
  --is-on)
    if is_on; then
      echo true
    else
      echo false
    fi
    ;;
  *)
    echo "Usage: $0 --toggle | --is-on" >&2
    exit 2
    ;;
esac

