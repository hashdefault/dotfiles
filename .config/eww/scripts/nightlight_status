#!/usr/bin/env bash

# Report whether hyprsunset (nightlight) is currently running.

STATE_FILE="${XDG_CACHE_HOME:-$HOME/.cache}/nightlight.state"
PID_FILE="${XDG_CACHE_HOME:-$HOME/.cache}/hyprsunset.pid"

status="false"

if [[ -f "$PID_FILE" ]]; then
  read -r pid <"$PID_FILE"
  if [[ "$pid" =~ ^[0-9]+$ ]] && kill -0 "$pid" 2>/dev/null; then
    status="true"
  else
    rm -f "$PID_FILE"
  fi
fi

# Fallback to a process search in case the PID file was lost.
if [[ "$status" == "false" ]] && pgrep -x hyprsunset >/dev/null 2>&1; then
  status="true"
fi

mkdir -p "$(dirname "$STATE_FILE")"

if [[ "$status" == "true" ]]; then
  echo "on" >"$STATE_FILE"
  echo "true"
else
  echo "off" >"$STATE_FILE"
  echo "false"
fi
