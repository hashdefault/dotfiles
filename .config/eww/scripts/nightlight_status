#!/usr/bin/env bash

# Report whether nightlight is currently active.
# Re-applies once per session if state says "on" (e.g. after restart).
# Uses hyprsunset on Wayland (Hyprland), redshift on X11 (Qtile).

STATE_FILE="${XDG_CACHE_HOME:-$HOME/.cache}/nightlight.state"
SYNC_FLAG="/tmp/nightlight-synced"
TEMP="${NIGHTLIGHT_TEMP:-4200}"

# Detect backend
if [[ "$XDG_SESSION_TYPE" == "wayland" ]]; then
  BACKEND="wayland"
else
  BACKEND="x11"
fi

mkdir -p "$(dirname "$STATE_FILE")"

if [[ -f "$STATE_FILE" ]]; then
  read -r state <"$STATE_FILE"
  if [[ "$state" == "on" ]]; then
    # Apply once if not yet synced this session
    if [[ ! -f "$SYNC_FLAG" ]]; then
      if [[ "$BACKEND" == "wayland" ]]; then
        pkill -x hyprsunset 2>/dev/null
        hyprsunset -t "$TEMP" &
        disown
      else
        redshift -x >/dev/null 2>&1
        redshift -O "$TEMP" >/dev/null 2>&1
      fi
      touch "$SYNC_FLAG"
    fi
    echo "true"
  else
    echo "false"
  fi
else
  echo "off" >"$STATE_FILE"
  echo "false"
fi
