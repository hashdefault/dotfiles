#!/usr/bin/env bash

# Report whether redshift (nightlight) is currently active.

STATE_FILE="${XDG_CACHE_HOME:-$HOME/.cache}/nightlight.state"

mkdir -p "$(dirname "$STATE_FILE")"

# Read state from file (maintained by nightlight script)
if [[ -f "$STATE_FILE" ]]; then
  read -r state <"$STATE_FILE"
  if [[ "$state" == "on" ]]; then
    echo "true"
  else
    echo "false"
  fi
else
  # Default to off if state file doesn't exist
  echo "off" >"$STATE_FILE"
  echo "false"
fi
