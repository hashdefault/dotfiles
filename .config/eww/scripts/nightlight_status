#!/usr/bin/env bash

# Print true if any supported night light backend is active
if pgrep -x hyprsunset >/dev/null 2>&1; then
  echo true
  exit 0
fi

if pgrep -x redshift >/dev/null 2>&1; then
  echo true
  exit 0
fi

if pgrep -x gammastep >/dev/null 2>&1; then
  echo true
  exit 0
fi

echo false

