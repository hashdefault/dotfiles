#!/usr/bin/env bash

# Toggle nightlight on/off.
# Uses hyprsunset on Wayland (Hyprland), redshift on X11 (Qtile).

STATE_FILE="${XDG_CACHE_HOME:-$HOME/.cache}/nightlight.state"
TEMP="${NIGHTLIGHT_TEMP:-4200}"
SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
ICON_ON="$SCRIPT_DIR/../images/lamp.svg"
ICON_OFF="$SCRIPT_DIR/../images/lamp-off.svg"

# Detect backend
if [[ "$XDG_SESSION_TYPE" == "wayland" ]]; then
  BACKEND="wayland"
  command -v hyprsunset >/dev/null 2>&1 || { echo "hyprsunset not found" >&2; exit 1; }
else
  BACKEND="x11"
  command -v redshift >/dev/null 2>&1 || { echo "redshift not found" >&2; exit 1; }
fi

mkdir -p "$(dirname "$STATE_FILE")"

if [[ -f "$STATE_FILE" ]]; then
  read -r CURRENT_STATE <"$STATE_FILE"
else
  CURRENT_STATE="off"
fi

stop_nightlight() {
  if [[ "$BACKEND" == "wayland" ]]; then
    pkill -x hyprsunset 2>/dev/null
    hyprsunset -i &
    sleep 0.2
    pkill -x hyprsunset 2>/dev/null
  else
    redshift -x >/dev/null 2>&1
  fi
}

start_nightlight() {
  if [[ "$BACKEND" == "wayland" ]]; then
    pkill -x hyprsunset 2>/dev/null
    hyprsunset -t "$TEMP" &
    disown
  else
    redshift -O "$TEMP" >/dev/null 2>&1
    return $?
  fi
}

send_notification() {
  command -v notify-send >/dev/null 2>&1 || return 0
  local state="$1"
  local icon="$2"
  notify-send -i "$icon" "Night light $state"
}

if [[ "$CURRENT_STATE" == "on" ]]; then
  stop_nightlight
  rm -f /tmp/nightlight-synced
  echo "off" >"$STATE_FILE"
  send_notification "off" "$ICON_OFF"
  echo "off"
else
  if start_nightlight; then
    echo "on" >"$STATE_FILE"
    touch /tmp/nightlight-synced
    send_notification "on" "$ICON_ON"
    echo "on"
  else
    echo "failed to enable nightlight" >&2
    exit 1
  fi
fi
