#!/usr/bin/env bash

# Toggle redshift on/off, tracking state locally for the "nightlight" toggle.

STATE_FILE="${XDG_CACHE_HOME:-$HOME/.cache}/nightlight.state"
TEMP="${REDSHIFT_TEMP:-4200}"
SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
ICON_ON="$SCRIPT_DIR/../images/lamp.svg"
ICON_OFF="$SCRIPT_DIR/../images/lamp-off.svg"

command -v redshift >/dev/null 2>&1 || {
  echo "redshift not found" >&2
  exit 1
}

mkdir -p "$(dirname "$STATE_FILE")"

if [[ -f "$STATE_FILE" ]]; then
  read -r CURRENT_STATE <"$STATE_FILE"
else
  CURRENT_STATE="off"
fi

stop_redshift() {
  redshift -x >/dev/null 2>&1
}

start_redshift() {
  redshift -O "$TEMP" >/dev/null 2>&1
  return $?
}

send_notification() {
  # Best effort notify; skip if notify-send is not available.
  command -v notify-send >/dev/null 2>&1 || return 0
  local state="$1"
  local icon="$2"
  notify-send -i "$icon" "Night light $state"
}

if [[ "$CURRENT_STATE" == "on" ]]; then
  stop_redshift
  echo "off" >"$STATE_FILE"
  send_notification "off" "$ICON_OFF"
  echo "off"
else
  if start_redshift; then
    echo "on" >"$STATE_FILE"
    send_notification "on" "$ICON_ON"
    echo "on"
  else
    echo "failed to enable nightlight" >&2
    exit 1
  fi
fi
