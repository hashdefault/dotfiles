#!/usr/bin/env bash

# Toggle Hyprsunset on/off, tracking state locally for the "nightlight" toggle.

STATE_FILE="${XDG_CACHE_HOME:-$HOME/.cache}/nightlight.state"
PID_FILE="${XDG_CACHE_HOME:-$HOME/.cache}/hyprsunset.pid"
TEMP="${HYPRSUNSET_TEMP:-4200}"
SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
ICON_ON="$SCRIPT_DIR/../images/lamp.svg"
ICON_OFF="$SCRIPT_DIR/../images/lamp-off.svg"

command -v hyprsunset >/dev/null 2>&1 || {
  echo "hyprsunset not found" >&2
  exit 1
}

mkdir -p "$(dirname "$STATE_FILE")"

if [[ -f "$STATE_FILE" ]]; then
  read -r CURRENT_STATE <"$STATE_FILE"
else
  CURRENT_STATE="off"
fi

stop_hyprsunset() {
  if [[ -f "$PID_FILE" ]]; then
    read -r pid <"$PID_FILE"
    if [[ "$pid" =~ ^[0-9]+$ ]] && kill -0 "$pid" 2>/dev/null; then
      kill "$pid" 2>/dev/null
      wait "$pid" 2>/dev/null
    fi
    rm -f "$PID_FILE"
  fi
}

start_hyprsunset() {
  hyprsunset --temperature "$TEMP" >/dev/null 2>&1 &
  local pid=$!
  echo "$pid" >"$PID_FILE"
  # confirm the process stuck around so the script can exit immediately
  sleep 0.1
  if kill -0 "$pid" 2>/dev/null; then
    disown "$pid" 2>/dev/null || true
    return 0
  fi

  rm -f "$PID_FILE"
  return 1
}

send_notification() {
  # Best effort notify; skip if notify-send is not available.
  command -v notify-send >/dev/null 2>&1 || return 0
  local state="$1"
  local icon="$2"
  notify-send -i "$icon" "Night light $state"
}

if [[ "$CURRENT_STATE" == "on" ]]; then
  stop_hyprsunset
  echo "off" >"$STATE_FILE"
  send_notification "off" "$ICON_OFF"
  echo "off"
else
  stop_hyprsunset
  if start_hyprsunset; then
    echo "on" >"$STATE_FILE"
    send_notification "on" "$ICON_ON"
    echo "on"
  else
    echo "failed to enable nightlight" >&2
    exit 1
  fi
fi
