#!/usr/bin/env bash

set -euo pipefail

choose_state_dir() {
  local base1="${XDG_CACHE_HOME:-$HOME/.cache}/eww"
  local base2="${XDG_STATE_HOME:-$HOME/.local/state}/eww"
  local base3="/tmp/eww-${USER:-$(id -u)}"
  for d in "$base1" "$base2" "$base3"; do
    mkdir -p "$d" 2>/dev/null || true
    if ( : >"$d/.write_test" ) 2>/dev/null; then
      rm -f "$d/.write_test" 2>/dev/null || true
      echo "$d"
      return
    fi
  done
  echo "$base3"
}

# Prefer cached value so the slider doesn't snap
state_dir="$(choose_state_dir)"
state_temp="$state_dir/nightlight_temp"
if [[ -f "$state_temp" ]]; then
  t=$(cat "$state_temp" 2>/dev/null || echo 4500)
  if [[ "$t" =~ ^[0-9]+$ ]]; then
    echo "$t"
    exit 0
  fi
fi

# Try to query backends when cache is missing
if command -v hyprctl >/dev/null 2>&1; then
  # Some versions support: hyprctl hyprsunset temperature
  out=$(hyprctl hyprsunset temperature 2>/dev/null || true)
  if [[ -n "${out:-}" && "$out" =~ ^[0-9]+$ ]]; then
    echo "$out"
    exit 0
  fi
fi

if command -v redshift >/dev/null 2>&1; then
  out=$(redshift -p 2>/dev/null | grep -i "color temperature" | awk '{print $3}' | tr -d 'K' || true)
  if [[ -n "${out:-}" && "$out" =~ ^[0-9]+$ ]]; then
    echo "$out"
    exit 0
  fi
fi

if command -v gammastep >/dev/null 2>&1; then
  out=$(gammastep -p 2>/dev/null | grep -i "color temperature" | awk '{print $3}' | tr -d 'K' || true)
  if [[ -n "${out:-}" && "$out" =~ ^[0-9]+$ ]]; then
    echo "$out"
    exit 0
  fi
fi

# Default
echo 6500
