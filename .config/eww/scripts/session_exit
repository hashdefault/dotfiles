#!/usr/bin/env bash
# Cross-desktop logout/exit helper for Wayland and Xorg
# Falls through to the next strategy whenever one is unavailable or fails.
set -uo pipefail   # NOT -e: we *want* to survive a failed attempt and try the next one

have()    { command -v "$1" >/dev/null 2>&1; }
running() { pgrep -x "$1" >/dev/null 2>&1; }

# Attempt a logout command. Exits the script on success; returns on failure.
try() {
  have "$1" || return 1
  "$@" && exit 0
  return 1
}

desktop="${XDG_CURRENT_DESKTOP:-}"

# --- niri ---
if [[ -n "${NIRI_SOCKET:-}" ]] || [[ "$desktop" =~ [Nn]iri ]] || running niri; then
  try niri msg action quit --skip-confirmation
  try niri msg action quit          # older builds without the flag (will prompt)
fi

# --- Hyprland ---
if [[ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]] || running Hyprland; then
  try hyprctl dispatch exit
fi

# --- sway ---
if running sway; then
  try swaymsg exit
fi

# --- river ---
if running river; then
  try riverctl exit
fi

# --- GNOME ---
if [[ "$desktop" =~ GNOME ]] || running gnome-shell; then
  try gnome-session-quit --logout --no-prompt
fi

# --- KDE Plasma ---
if [[ "$desktop" =~ KDE ]] || running plasmashell; then
  try qdbus6 org.kde.Shutdown /Shutdown org.kde.Shutdown.logout
  try qdbus  org.kde.ksmserver /KSMServer logout 0 0 0
fi

# --- Qtile ---
if running qtile; then
  try qtile cmd-obj -o cmd -f shutdown
fi

# --- Xorg WMs ---
if [[ "${XDG_SESSION_TYPE:-}" == x11 || -n "${DISPLAY:-}" ]]; then
  running i3     && try i3-msg exit
  running xmonad && try pkill -x xmonad
  running awesome && try awesome-client 'awesome.quit()'
fi

# --- Fallback: ask logind/elogind to kill this session ---
session_id="${XDG_SESSION_ID:-}"
if [[ -z "$session_id" ]] && have loginctl; then
  session_id=$(loginctl --no-legend list-sessions | awk -v u="$USER" '$3 == u { print $1; exit }')
fi
[[ -n "$session_id" ]] && try loginctl terminate-session "$session_id"

# --- Last resort ---
try loginctl terminate-user "$USER"

echo "logout: no working method found" >&2
exit 1
