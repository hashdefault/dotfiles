#!/usr/bin/env bash
# Cross-desktop logout/exit helper for Wayland and Xorg
# Falls through to the next strategy whenever one is unavailable or fails.
set -uo pipefail   # NOT -e: we *want* to survive a failed attempt and try the next one

have()    { command -v "$1" >/dev/null 2>&1; }
running() { pgrep -x "$1" >/dev/null 2>&1; }

# Print the current graphical logind session. Eww normally inherits
# XDG_SESSION_ID, but fall back to querying logind when it does not.
graphical_session_id() {
  local session_id="${XDG_SESSION_ID:-}"
  local session_uid type active
  local current_uid

  have loginctl || return 1
  current_uid=$(id -u)

  if [[ -n "$session_id" ]]; then
    session_uid=$(loginctl show-session "$session_id" -p User --value 2>/dev/null) || session_uid=""
    if [[ "$session_uid" == "$current_uid" ]]; then
      printf '%s\n' "$session_id"
      return 0
    fi
  fi

  while read -r session_id; do
    [[ -n "$session_id" ]] || continue
    type=$(loginctl show-session "$session_id" -p Type --value 2>/dev/null) || continue
    active=$(loginctl show-session "$session_id" -p Active --value 2>/dev/null) || continue
    if [[ "$active" == "yes" && ( "$type" == "x11" || "$type" == "wayland" ) ]]; then
      printf '%s\n' "$session_id"
      return 0
    fi
  done < <(loginctl --no-legend list-sessions 2>/dev/null | awk -v uid="$current_uid" '$2 == uid { print $1 }')

  return 1
}

# Attempt a logout command. Exits the script on success; returns on failure.
try() {
  have "$1" || return 1
  "$@" && exit 0
  return 1
}

desktop="${XDG_CURRENT_DESKTOP:-}"

# --- niri ---
if [[ -n "${NIRI_SOCKET:-}" ]] || [[ "$desktop" =~ [Nn]iri ]] || running niri; then
  try niri msg action quit --skip-confirmation
  try niri msg action quit          # older builds without the flag (will prompt)
fi

# --- Hyprland ---
if [[ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]] || running Hyprland; then
  try hyprctl dispatch exit
fi

# --- sway ---
if running sway; then
  try swaymsg exit
fi

# --- river ---
if running river; then
  try riverctl exit
fi

# --- GNOME ---
if [[ "$desktop" =~ GNOME ]] || running gnome-shell; then
  try gnome-session-quit --logout --no-prompt
fi

# --- KDE Plasma ---
if [[ "$desktop" =~ KDE ]] || running plasmashell; then
  try qdbus6 org.kde.Shutdown /Shutdown org.kde.Shutdown.logout
  try qdbus  org.kde.ksmserver /KSMServer logout 0 0 0
fi

# --- Qtile ---
if running qtile; then
  try qtile cmd-obj -o cmd -f shutdown
fi

# --- Xorg WMs ---
if [[ "${XDG_SESSION_TYPE:-}" == x11 || -n "${DISPLAY:-}" ]]; then
  running i3     && try i3-msg exit
  running awesome && try awesome-client 'awesome.quit()'
fi

# --- XMonad ---
# The display manager (sddm-helper) runs xmonad directly as the session
# process, so making xmonad exit ends the session cleanly, the same as
# `io exitSuccess`. Terminating the whole logind session instead also kills
# sddm-helper, which leaves the X server alive with only the wallpaper.
# The compiled binary is usually named xmonad-<arch>-<os>, which pgrep -x
# cannot match (process names are truncated to 15 chars), so match the command.
if [[ -n "${DISPLAY:-}" ]]; then
  xmonad_pids=$(pgrep -u "$(id -u)" -f '^(\S*/)?xmonad(-\S+)?( |$)' 2>/dev/null) || xmonad_pids=""
  for pid in $xmonad_pids; do
    # Only touch the xmonad that manages this display.
    tr '\0' '\n' < "/proc/$pid/environ" 2>/dev/null | grep -qx "DISPLAY=$DISPLAY" || continue
    kill -TERM "$pid" 2>/dev/null && exit 0
  done
fi

# --- Fallback: ask logind/elogind to kill this session ---
session_id=$(graphical_session_id) || session_id=""
[[ -n "$session_id" ]] && try loginctl terminate-session "$session_id"

# --- Last resort ---
try loginctl terminate-user "$USER"

echo "logout: no working method found" >&2
exit 1
