/* Sleek menu theme tuned for quick scanning and clear selection */
* {
  font:               "JetBrainsMono Nerd Font 12";
  bg:                 #0d0f10;
  surface:            #14171a;
  overlay:            #1c1f24;
  fg:                 #f2f2f2;
  muted:              #9ea5ad;
  accent:             #89dd6f;   /* matcha green accent */
  accent-strong:      #a6e68e;   /* brighter hover/selection */
  urgent:             #ff6c6b;
  red:                #ff6c6b;
}

window {
  background-color:   @bg;
  border:             2px;
  border-color:       @accent;
  border-radius:      14px;
  padding:            16;
  width:              38%;
}

mainbox {
  spacing:            12;
}

inputbar {
  children:           [ prompt, entry ];
  background-color:   @overlay;
  padding:            10 12;
  border-radius:      10px;
  text-color:         @fg;
}

prompt {
  padding:            0 8 0 0;
  text-color:         @accent;
}

entry {
  text-color:         @fg;
}

listview {
  lines:              10;
  columns:            1;
  spacing:            8;
  scrollbar:          false;
  padding:            8 0 0 0;
}

element {
  padding:            10 12;
  border-radius:      10px;
}

element normal.normal {
  background-color:   transparent;
  text-color:         @fg;
}

element alternate.normal {
  background-color:   @surface;
  text-color:         @fg;
}

element selected.normal {
  background-color:   @accent-strong;
  text-color:         @bg;
}

element normal.urgent {
  background-color:   @urgent;
  text-color:         @bg;
}

element selected.urgent {
  background-color:   @urgent;
  text-color:         @bg;
}

element-text,
element-icon {
  background-color:   inherit;
  text-color:         inherit;
}

textbox,
message {
  background-color:   @overlay;
  text-color:         @fg;
  padding:            8 10;
  border-radius:      10px;
}

button {
  background-color:   @surface;
  text-color:         @fg;
  padding:            6 10;
  margin:             4;
  border-radius:      10px;
}

button selected {
  background-color:   @accent;
  text-color:         @bg;
}
