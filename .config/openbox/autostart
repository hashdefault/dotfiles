#!/bin/bash
# ═══════════════════════════════════════════════════════
# Eldritch Openbox Autostart
# ═══════════════════════════════════════════════════════

# ── Desktop portal environment ──
export XDG_CURRENT_DESKTOP=openbox
export XDG_SESSION_DESKTOP=openbox
export DESKTOP_SESSION=openbox
dbus-update-activation-environment --systemd XDG_CURRENT_DESKTOP XDG_SESSION_DESKTOP DESKTOP_SESSION
systemctl --user import-environment XDG_CURRENT_DESKTOP XDG_SESSION_DESKTOP DESKTOP_SESSION

# ── Keyboard ──
xset b off &
setxkbmap us altgr-intl &
xset r rate 200 40 &

# ── Compositor ──
picom --config ~/.config/picom/picom.conf &

# ── Wallpaper ──
~/.fehbg &

# ── Notifications ──
dunst -config ~/.config/dunst/dunstrc &

# ── Top panel (tint2) ──
tint2 -c ~/.config/tint2/tint2rc &

# ── Bottom dock (plank) — both monitors ──
plank --name dock1 &

# ── Eww daemon (popup widgets only: powermenu, notifications, sidemenu, etc.) ──
sleep 0.5
eww daemon &

# ── Network & Bluetooth applets ──
nm-applet &
blueman-applet &

(sleep 1 && ~/.screenlayout/dual-mon.sh) &

# ── Polkit agent ──
/usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1 &

# ── Night light (redshift) ──
redshift -x
redshift -O 4200 &

# ── Welcome notification ──
sleep 2 && ~/.local/bin/welcome-notify.sh &

# ── Autostart user applications (if any) ──
# Add yours below
