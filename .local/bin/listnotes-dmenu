#!/bin/bash
# Notes browser using dmenu

dir_path="$HOME/Docs/Notes"
prompt_icon="󱓧"

# Ensure base notes directory exists
[ -d "$dir_path" ] || mkdir -p "$dir_path"

select_note() {
  local path="$1"

  # Build list: Up entry, then directories/, then files (case-insensitive sort)
  local up_entry="../"
  local dirs files
  dirs=$(find "$path" -maxdepth 1 -mindepth 1 -type d -printf '%P/\n' 2>/dev/null | sort -f)
  files=$(find "$path" -maxdepth 1 -mindepth 1 -type f -printf '%P\n' 2>/dev/null | sort -f)

  printf "%s\n%s\n%s\n" "$up_entry" "$dirs" "$files" | dmenu -i -l 10 \
    -fn "JetBrainsMono Nerd Font:size=10" \
    -nb '#121222' -nf '#cccccc' -sb '#00ff99' -sf '#121222' \
    -p "$prompt_icon  ${path/#$HOME/~}:"
}

launch_editor() {
  local filepath="$1"

  if command -v ghostty >/dev/null 2>&1; then
    ghostty \
      --shell-integration='fish' \
      --working-directory="$HOME/Docs/Notes" \
      -e nvim -- "$filepath"
  elif [ -n "$TERMINAL" ] && command -v "$TERMINAL" >/dev/null 2>&1; then
    "$TERMINAL" -e nvim -- "$filepath"
  else
    xterm -e nvim -- "$filepath"
  fi
}

main() {
  while true; do
    selection=$(select_note "$dir_path")

    # Exit if nothing selected
    [ -z "$selection" ] && exit

    filepath="$dir_path/$selection"

    # If it's a directory, dive in
    if [ -d "$filepath" ]; then
      dir_path="$filepath"
      continue
    fi

    # Navigate up when selecting ../ explicitly
    if [ "$selection" = ".." ] || [ "$selection" = "../" ]; then
      dir_path="$(dirname "$dir_path")"
      continue
    fi

    # If it's a file, check its MIME type for text/*
    if [ -f "$filepath" ]; then
      mime=$(file --brief --mime-type -- "$filepath")
      if [[ "$mime" == text/* ]]; then
        break
      else
        notify-send "  Not a text file. Try another."
        continue
      fi
    fi

    # If it doesn't exist, offer to create it
    dmenu_confirm=$(printf "Yes\nNo" | dmenu -i \
      -fn "JetBrainsMono Nerd Font:size=10" \
      -nb '#121222' -nf '#cccccc' -sb '#00ff99' -sf '#121222' \
      -p "$prompt_icon  '$selection' doesn't exist. Create it?")
    if [ "$dmenu_confirm" = "Yes" ]; then
      touch "$filepath"
      break
    fi
  done

  launch_editor "$filepath"
}

main
