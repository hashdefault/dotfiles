#!/bin/sh

# Informa aos apps que estamos no Wayland
export XDG_SESSION_TYPE=wayland
# Informa que estamos usando um compositor base wlroots (dwl, sway, hyprland)
export XDG_CURRENT_DESKTOP=wlroots
# Força Firefox e apps baseados em Mozilla a usar Wayland nativo
export MOZ_ENABLE_WAYLAND=1
# Corrige problemas de apps Java
export _JAVA_AWT_WM_NONREPARENTING=1


# Polkit: Necessário para apps pedirem senha (ex: GParted, gerenciadores de arquivo)
# No Arch, instale: polkit-gnome
if [ -f /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1 ]; then
    /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1 &
fi


exec slstatus -s | dwl
