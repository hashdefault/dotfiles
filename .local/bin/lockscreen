#!/bin/bash
# Lockscreen script using swaylock-effects with cyberpunk theme

swaylock \
    --screenshots \
    --clock \
    --indicator \
    --indicator-radius 100 \
    --indicator-thickness 10 \
    --effect-blur 10x5 \
    --effect-vignette 0.5:0.5 \
    --color 0a0a0a \
    --inside-color 0a0a0a88 \
    --ring-color 00ff41 \
    --key-hl-color 00ffff \
    --bs-hl-color ff0080 \
    --ring-ver-color 00ffaa \
    --inside-ver-color 0a0a0a88 \
    --ring-wrong-color ff0080 \
    --inside-wrong-color 0a0a0a88 \
    --ring-clear-color 00ffff \
    --inside-clear-color 0a0a0a88 \
    --line-color 00000000 \
    --separator-color 00000000 \
    --text-color 00ff41 \
    --text-ver-color 00ffaa \
    --text-wrong-color ff0080 \
    --text-clear-color 00ffff \
    --font "JetBrainsMono Nerd Font" \
    --timestr "%I:%M %p" \
    --datestr "%A, %B %d" \
    --show-failed-attempts \
    --fade-in 0.3 \
    --daemonize
