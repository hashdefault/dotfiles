#!/bin/bash
# Lockscreen script using swaylock-effects.
# Colors come from ~/.config/swaylock/theme.conf, regenerated by
# ~/.config/hypr/scripts/theme-chooser.sh on every theme switch.

swaylock \
    --config "$HOME/.config/swaylock/theme.conf" \
    --screenshots \
    --clock \
    --indicator \
    --indicator-radius 100 \
    --indicator-thickness 10 \
    --effect-blur 4x2 \
    --effect-vignette 0.5:0.5 \
    --font "JetBrainsMono Nerd Font" \
    --timestr "%I:%M %p" \
    --datestr "%A, %B %d" \
    --show-failed-attempts \
    --fade-in 0.3 \
    --daemonize
