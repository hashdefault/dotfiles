#!/bin/sh

# 1. Define the options
options="Shutdown\nReboot\nSuspend\nLogout\nLock"

# 2. Show the menu with wmenu
# We pipe the options into wmenu and save the result to the variable 'selected'
selected=$(echo -e "$options" | wmenu -i -l 5 -p "Power:" \
    -N '#1e1e2e' -n '#cdd6f4' -S '#cba6f7' -s '#1e1e2e')

# 3. Execute the choice
case "$selected" in
    Shutdown)
        systemctl poweroff ;;
    Reboot)
        systemctl reboot ;;
    Suspend)
        systemctl suspend ;;
    Logout)
        # Kills dwl to return to SDDM/TTY
        pkill dwl ;;
    Lock)
        # Requires swaylock or wlock installed
        swaylock -c 000000 ;;
esac
