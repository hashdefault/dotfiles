#!/bin/sh

# 1. Define the options
options="Shutdown\nReboot\nSuspend\nLogout\nLock"

# 2. Show the menu with wmenu
# We pipe the options into wmenu and save the result to the variable 'selected'
selected=$(echo -e "$options" | wmenu -i -f "JetBrainsMono Nerd Font 10" -l 5 -p "Power:" \
    -N '#121222' -n '#dcdcdc' -M '#121222' -m '#00ff99' -S '#00ff99' -s '#121222')

# 3. Execute the choice
case "$selected" in
    Shutdown)
        systemctl poweroff ;;
    Reboot)
        systemctl reboot ;;
    Suspend)
        systemctl suspend ;;
    Logout)
        # Kills dwl to return to SDDM/TTY
        pkill dwl ;;
    Lock)
        # Requires swaylock or wlock installed
        exec ~/.local/bin/swaylock-screen ;;
esac
